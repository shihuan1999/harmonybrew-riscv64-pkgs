#!/system/bin/sh
# brewboot v9 — Harmonybrew boot-time starter (called by hbrew-init).
#
# ZERO-STEP INSTALL MODEL (v8)
#   Brewed COMMANDS are published onto the system path as individual symlinks:
#       /system/bin/<cmd> -> /data/harmonybrew/bin/<cmd>
#   /system/bin is already on PATH for every shell and service, so anything
#   `brew install`ed is usable immediately, exactly like apt.
#
#   LIBRARIES ARE NEVER PUBLISHED TO /system/lib64.
#   That directory is the dynamic loader's default search path for the WHOLE
#   device. Brewed copies of libssl/libcrypto/libsqlite3/libffi/libz/shadowed
#   the image's own libraries, StorageDaemon failed to mount /mnt (read-only),
#   no app could be spawned and the device hung on the boot animation.
#   Reproduced twice on hardware. Brewed binaries get their libraries from the
#   rpath baked in at build time (-Wl,-rpath,/data/harmonybrew/lib).
#
#   The same reasoning bans the old /usr/local/{bin,lib} farm bind-mounts
#   (/usr/local/lib is on musl's default search path). They are removed here.
#
# This script:
#   1) removes any legacy /usr/local/{bin,lib} bridge
#   2) regenerates the farms (kept as the manifest source of truth)
#   3) republishes system-path links (remount rw -> link -> remount ro)
#   4) starts the farm watcher, which re-runs step 3 when kegs change
#   5) starts enabled services from var/services/enabled/*.service

BREW_PREFIX="/data/harmonybrew"
LOG="$BREW_PREFIX/var/log/brewboot.log"
BREW_SVC="$BREW_PREFIX/bin/brew-services"
ENABLED_DIR="$BREW_PREFIX/var/services/enabled"

log() { echo "$(date '+%m-%d %H:%M:%S') [brewboot] $*" >> "$LOG"; }

mkdir -p "$BREW_PREFIX/var/log" "$BREW_PREFIX/var/run" "$ENABLED_DIR"

log "===== brewboot v9 start ====="

# --- 0) /mnt self-heal (image boot-race workaround) -------------------------
# On some boots the early tmpfs at /mnt comes up READ-ONLY. StorageDaemon then
# fails to create /mnt/sandbox (errno=30 EROFS) around t+9s, AppSpawn cannot
# build any app sandbox, no application can be forked, and the device stays on
# the boot animation while all UI services look healthy. Remounting that tmpfs
# rw immediately unblocks the waiting services (verified on hardware: launcher
# comes up within seconds, no reboot needed). A tmpfs holds no persistent data,
# so doing this unconditionally is safe.
if mount 2>/dev/null | grep -q ' on /mnt type tmpfs (ro,'; then
  if mount -o remount,rw /mnt 2>/dev/null; then
    log "/mnt was read-only at boot: remounted rw (unblocks StorageDaemon)"
  else
    log "WARN: /mnt read-only and remount failed"
  fi
fi

# --- 1) legacy /usr/local bridges are reaped by hbrew-systemlink v3 (step 3)

# --- 2) farms (manifest source) ---
"$BREW_PREFIX/sbin/hbrew-farm" >/dev/null 2>&1

# --- 3) publish onto /system paths (commands only; libs NEVER) ---
if mount -o remount,rw / 2>/dev/null; then
  # systemlink v3 additionally reaps: unsafe /system/lib64 links, the
  # /usr/local farm (PATH #1 hazard), and dangling entries of removed kegs.
  "$BREW_PREFIX/sbin/hbrew-systemlink" >/dev/null 2>&1
  sync
  mount -o remount,ro / 2>/dev/null
  log "system-path command links refreshed (libs never published)"
else
  log "WARN: could not remount / rw; system-path links not refreshed"
fi

# --- 4) farm watcher (re-publishes when kegs change) ---
if [ -x "$BREW_PREFIX/sbin/hbrew-farm-watch" ]; then
  if grep -qs hbrew-farm-watch /proc/[0-9]*/cmdline; then
    log "farm watcher already running"
  else
    "$BREW_PREFIX/sbin/hbrew-farm-watch" >/dev/null 2>&1 &
    log "farm watcher started"
  fi
fi

# wait for /data ready (max 30s)
i=0
while [ "$i" -lt 15 ]; do
  [ -d "$BREW_PREFIX/bin" ] && break
  sleep 2; i=$((i + 1))
done

if [ ! -x "$BREW_SVC" ]; then
  log "brew-services not found at $BREW_SVC, abort"
  exit 1
fi

# --- 5) enabled services ---
started=""
for f in "$ENABLED_DIR"/*.service; do
  [ -f "$f" ] || continue
  name=$(basename "$f" .service)
  log "starting enabled service: $name"
  "$BREW_SVC" start "$name" >> "$LOG" 2>&1
  rc=$?
  if [ "$rc" -eq 0 ]; then
    started="$started $name"
    log "$name: ok"
  else
    log "$name: failed (rc=$rc)"
  fi
done

[ -n "$started" ] && log "boot services started:$started"

log "===== brewboot v9 done ====="
