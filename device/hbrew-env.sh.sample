# Harmonybrew environment (OHOS riscv64) — source with:  . /data/harmonybrew/hbrew-env.sh
# Generated by hbrew-init; regenerate: delete this file and rerun hbrew-init.
# Must mirror the working deployment: brew needs CELLAR/REPOSITORY, its own
# portable-git on PATH, and the CA bundle in three spellings (ruby/curl/git).
export HOMEBREW_PREFIX="/data/harmonybrew"
export HOMEBREW_HOME="/data/harmonybrew"
export HOMEBREW_CELLAR="/data/harmonybrew/Cellar"
export HOMEBREW_REPOSITORY="/data/harmonybrew"
export HOME="/data/harmonybrew/home"
export PATH="/data/harmonybrew/bin:/data/harmonybrew/sbin:/data/harmonybrew/Library/Homebrew/vendor/portable-git/current/bin:/system/bin:/bin:$PATH"
export HOMEBREW_NO_INSTALL_FROM_API=1
export HOMEBREW_NO_AUTO_UPDATE=1
export HOMEBREW_NO_ANALYTICS=1
export HOMEBREW_NO_ENV_HINTS=1
export HOMEBREW_NO_INSTALL_CLEANUP=1
export TMPDIR="/data/harmonybrew/tmp"
export LD_LIBRARY_PATH="/data/harmonybrew/lib:${LD_LIBRARY_PATH:-}"
export SSL_CERT_FILE="/data/harmonybrew/etc/ssl/cacert.pem"
export SSL_CERT_DIR="/data/harmonybrew/etc/ssl"
export CURL_CA_BUNDLE="/data/harmonybrew/etc/ssl/cacert.pem"
export GIT_SSL_CAINFO="/data/harmonybrew/etc/ssl/cacert.pem"

# zero-step PATH farm: refresh /usr/local/bin view on every brew invocation
( /data/harmonybrew/sbin/hbrew-farm >/dev/null 2>&1 & ) 2>/dev/null
