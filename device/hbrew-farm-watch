#!/system/bin/sh
# hbrew-farm-watch v6 — keep the /data farm in sync with installed kegs.
#
# HARD CONSTRAINT: this watcher never remounts anything and never writes
# outside /data. Doing either during boot breaks the image's boot validation
# (see docs/WHY-APT-WORKS-BREW-BROKE.md §7): /mnt's tmpfs is demoted to
# read-only, StorageDaemon cannot build /mnt/sandbox, bootevent.boot.completed
# never fires, and the device stays on the boot animation forever.
#
# The PATH bridge it feeds is a persistent rootfs symlink
#   /usr/local -> /data/harmonybrew/var/usrlocal
# created once at runtime by hbrew-enable-bridge. Nothing here recreates it.
#
# Usage: hbrew-farm-watch           (foreground; start with setsid/nohup)
#        hbrew-farm-watch --once    (single pass; use from brew hooks)

P=/data/harmonybrew
BIN="$P/bin"
STAMP="$P/var/.farm-listing"
CMD="$P/sbin/hbrew-farm-build"

listing() { ls "$BIN" 2>/dev/null; }

if [ "${1:-}" = "--once" ]; then
    "$CMD" >/dev/null 2>&1
    listing > "$STAMP" 2>/dev/null
    exit 0
fi

SLEEP="$BIN/busybox"
[ -x "$SLEEP" ] || SLEEP=sleep

mkdir -p "$P/var" 2>/dev/null
listing > "$STAMP" 2>/dev/null

while :; do
    cur="$P/var/.farm-listing.cur"
    listing > "$cur" 2>/dev/null
    if ! cmp -s "$cur" "$STAMP" 2>/dev/null; then
        # a keg was installed or removed: refresh the farm (/data writes only)
        "$CMD" >/dev/null 2>&1
        mv -f "$cur" "$STAMP" 2>/dev/null
    fi
    rm -f "$cur" 2>/dev/null
    "$SLEEP" sleep 2 >/dev/null 2>&1 || sleep 3
done
