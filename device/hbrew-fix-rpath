#!/system/bin/sh
# hbrew-fix-rpath — report (and optionally repoint) build-host RPATHs in a keg.
#
# PROBLEM
#   Packages built on the compile server often carry RPATHs pointing at the
#   *build staging* directory, e.g.
#       /home/<user>/WorkSpace/.../stage-jq/jq/1.8.1/lib
#   That path does not exist on the device, so the binary cannot find its own
#   libraries ("Error loading shared library libjq.so.1") even though the .so
#   sits next to it in the keg.
#
# POLICY
#   The durable fix belongs in the BUILD pipeline: hbrew-pkg/scripts/build.sh
#   rewrites every ELF's RPATH to
#       /data/harmonybrew/lib:<keg>/lib
#   before packing the bottle (see scripts/elf_rpath.py).
#   This device-side tool exists only to *audit* a keg, and to repair one that
#   slipped through, without needing patchelf.
#
# Usage: hbrew-fix-rpath <keg-dir> [--check]

PREFIX=/data/harmonybrew
READELF=/data/hap-dev/toolchain/llvm/bin/llvm-readelf
CHECK=0
for a in "$@"; do
  case "$a" in
    --check) CHECK=1 ;;
    *) KEG="$a" ;;
  esac
done
[ -n "${KEG:-}" ] || { echo "usage: hbrew-fix-rpath <keg-dir> [--check]" >&2; exit 2; }
[ -d "$KEG" ] || { echo "not a directory: $KEG" >&2; exit 2; }

[ -x "$READELF" ] || READELF=readelf

bad=0
for f in "$KEG"/bin/*; do
  [ -f "$f" ] || continue
  case "$f" in *.real) continue ;; esac
  head -c 2 "$f" 2>/dev/null | grep -q '#!' && continue
  info="$("$READELF" -d "$f" 2>/dev/null | grep -E 'RPATH|RUNPATH')" || continue
  [ -n "$info" ] || continue
  cur="$(printf '%s' "$info" | sed -n 's/.*Library r\(un\)\{0,1\}path: \[\(.*\)\]/\2/p')"
  case "$cur" in
    "$PREFIX"*) continue ;;
  esac
  bad=$((bad + 1))
  echo "BAD RPATH: ${f#"$KEG"/}"
  echo "           $cur"
  if [ "$CHECK" = 0 ]; then
    echo "           fix at build time: scripts/elf_rpath.py --set <file> $PREFIX/lib"
  fi
done

echo "hbrew-fix-rpath: bad=$bad"
[ "$bad" = 0 ]
