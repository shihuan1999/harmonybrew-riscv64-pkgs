#!/system/bin/sh
# hbrew-systemlink v3 — apt-style publication of brewed commands.
#
# MODEL (learned the hard way; see WHY-APT-WORKS-BREW-BROKE.md)
#   apt publishes ONE FILE PER PACKAGE ENTRY into a system bin dir and refuses
#   on any conflict. We do exactly that:
#
#       /system/bin/<cmd> -> /data/harmonybrew/bin/<cmd>
#       created ONLY when /system/bin/<cmd> does not already exist
#
#   /system/bin is already on PATH (via /bin) for every shell and service, so
#   nothing needs PATH surgery — and nothing can outrank the system.
#
# HARD RULES
#   1. A name the image already ships is NEVER replaced. System wins silently.
#   2. LIBRARIES ARE NEVER PUBLISHED. /system/lib64 is the loader's default
#      search path for every process; a brewed libssl/libcrypto/libsqlite3
#      there shadows the image's own copy and stalls boot (verified twice).
#      Brewed binaries use the rpath baked at build time instead:
#          -Wl,-rpath,/data/harmonybrew/lib
#   3. /usr/local/bin is NEVER used as a farm. It sits BEFORE /bin in PATH,
#      so a directory-level exposure there silently outranks every system
#      command (busybox's 400 applets took over ls/cp/cat/ps/df… and broke
#      the boot chain). v3 actively deletes such leftovers.
#   4. Multi-applet packages (busybox, coreutils, …) are NOT published: their
#      applets collide wholesale with the system's own tools. Call them
#      explicitly via `busybox <applet>` or the keg path.
#   5. Only individual symlinks; `brew uninstall` + per-run reap keeps
#      /system/bin exactly equal to the set of installed kegs.
#
# Usage: hbrew-systemlink [--dry-run] [--verbose]

BREW_PREFIX="/data/harmonybrew"
SYS_BIN="/system/bin"
SYS_LIB="/system/lib64"
STATE_DIR="$BREW_PREFIX/var/systemlink"
MANIFEST="$STATE_DIR/manifest.txt"
LOG="$BREW_PREFIX/var/log/hbrew-systemlink.log"

DRY=0
VERBOSE=0
for a in "$@"; do
  case "$a" in
    --dry-run) DRY=1 ;;
    --verbose|-v) VERBOSE=1 ;;
  esac
done

log() { echo "$(date '+%m-%d %H:%M:%S') [systemlink] $*" >> "$LOG"; }
say() { [ "$VERBOSE" = 1 ] && echo "$*"; }

mkdir -p "$STATE_DIR" 2>/dev/null

# --- names we never publish -------------------------------------------------
# (a) Homebrew plumbing
# (b) the utilities the boot chain itself depends on: replacing any of these
#     with a brewed build is what broke the device. Kept out permanently.
skip_bin_name() {
  case "$1" in
    # Homebrew plumbing
    brew|brew-*|hbrew-*|python-env.sh) return 0 ;;
    # boot-chain critical: init jobs, appspawn, storage_daemon, hdc
    sh|ash|bash|env|ls|ps|cat|cp|mv|rm|ln|mkdir|rmdir|chmod|chown|chgrp|\
    mount|umount|dd|sync|kill|killall|sleep|date|df|du|stat|readlink|\
    realpath|pwd|echo|printf|test|[|expr|true|false|id|whoami|uname|\
    hostname|ifconfig|route|ping|netstat|tar|gzip|gunzip|sed|grep|awk|\
    find|xargs|sort|uniq|wc|head|tail|cut|tr|tee|touch|mktemp|mknod|\
    dmesg|free|uptime|top|nohup|time|which|wget|vi|ed|less|more)
      return 0 ;;
  esac
  return 1
}

# Packages whose keg content must not be published wholesale: they provide a
# large set of names that collide with the system's own tools.
skip_package_bins() {
  for p in /data/harmonybrew/Cellar/busybox* /data/harmonybrew/Cellar/coreutils*; do
    [ -d "$p" ] || continue
    case "$1" in
      "$p"/*) return 0 ;;
    esac
  done
  return 1
}

now_linked=0
now_skipped=0
now_fixed=0
now_reaped=0

ensure_link() {   # ensure_link <src> <dest>
  src="$1"; dest="$2"
  if [ -e "$dest" ] && [ ! -L "$dest" ]; then
    say "SKIP (system owns): $dest"
    now_skipped=$((now_skipped + 1))
    return 0
  fi
  if [ -L "$dest" ]; then
    if [ "$(readlink "$dest")" = "$src" ]; then
      say "ok (already): $dest"
      return 0
    fi
    case "$(readlink "$dest")" in
      "$BREW_PREFIX"/*) say "FIX: $dest"; now_fixed=$((now_fixed + 1)) ;;
      *) say "SKIP (foreign link): $dest"; now_skipped=$((now_skipped + 1)); return 0 ;;
    esac
  fi
  if [ "$DRY" = 1 ]; then
    say "WOULD LINK $dest -> $src"
    return 0
  fi
  rm -f "$dest" 2>/dev/null
  ln -s "$src" "$dest" 2>/dev/null || { say "FAIL: $dest"; return 0; }
  now_linked=$((now_linked + 1))
  echo "$dest|$src" >> "$MANIFEST"
  say "LINK $dest -> $src"
}

reap_dangling() {   # reap_dangling <dir>
  d="$1"
  for l in "$d"/*; do
    [ -L "$l" ] || continue
    tgt="$(readlink "$l")"
    case "$tgt" in
      "$BREW_PREFIX"/*) ;;
      *) continue ;;
    esac
    [ -e "$l" ] && continue
    if [ "$DRY" = 1 ]; then
      say "WOULD REMOVE dangling: $l -> $tgt"
    else
      rm -f "$l" 2>/dev/null
      say "REMOVED dangling: $l -> $tgt"
      now_reaped=$((now_reaped + 1))
    fi
  done
}

# Emergency cleanup: brewed libraries must never sit on the global search path.
reap_lib_links() {
  [ -d "$SYS_LIB" ] || return 0
  for l in "$SYS_LIB"/*; do
    [ -L "$l" ] || continue
    tgt="$(readlink "$l")"
    case "$tgt" in
      "$BREW_PREFIX"/*) ;;
      *) continue ;;
    esac
    if [ "$DRY" = 1 ]; then
      say "WOULD REMOVE unsafe lib link: $l -> $tgt"
    else
      rm -f "$l" 2>/dev/null
      say "REMOVED unsafe lib link: $l -> $tgt"
      now_reaped=$((now_reaped + 1))
    fi
  done
}

# Emergency cleanup: the /usr/local farm must never come back (PATH #1).
reap_usrlocal_farm() {
  [ -d /usr/local ] || return 0
  # the symlink /usr/local/bin -> farm (v1-v5 style)
  if [ -L /usr/local/bin ]; then
    case "$(readlink /usr/local/bin)" in
      "$BREW_PREFIX"/*)
        if [ "$DRY" = 1 ]; then
          say "WOULD REMOVE /usr/local/bin farm link"
        else
          rm -f /usr/local/bin
          say "REMOVED /usr/local/bin farm link"
          now_reaped=$((now_reaped + 1))
        fi
        ;;
    esac
  fi
  # individual links inside a real /usr/local/bin
  if [ -d /usr/local/bin ] && [ ! -L /usr/local/bin ]; then
    for l in /usr/local/bin/*; do
      [ -L "$l" ] || continue
      case "$(readlink "$l")" in
        "$BREW_PREFIX"/*)
          if [ "$DRY" = 1 ]; then
            say "WOULD REMOVE /usr/local/bin link: $l"
          else
            rm -f "$l"
            now_reaped=$((now_reaped + 1))
          fi
          ;;
      esac
    done
  fi
  [ -d /usr/local/lib ] || [ -L /usr/local/lib ] && \
    case "$(readlink /usr/local/lib 2>/dev/null)" in
      "$BREW_PREFIX"/*)
        if [ "$DRY" = 0 ]; then
          rm -rf /usr/local/lib
          say "REMOVED /usr/local/lib bridge"
          now_reaped=$((now_reaped + 1))
        fi
        ;;
    esac
  return 0
}

[ "$DRY" = 1 ] || : > "$MANIFEST" 2>/dev/null

# ---- 0) kill the two harmful patterns, whatever created them ----
reap_lib_links
reap_usrlocal_farm

# ---- 1) publish commands, system-first ----
reap_dangling "$SYS_BIN"
for f in "$BREW_PREFIX"/bin/*; do
  [ -e "$f" ] || continue
  b="${f##*/}"
  skip_bin_name "$b" && continue
  skip_package_bins "$f" && continue
  [ -f "$f" ] || continue
  ensure_link "$f" "$SYS_BIN/$b"
done

log "run done: linked=$now_linked skipped=$now_skipped fixed=$now_fixed reaped=$now_reaped dry=$DRY"
if [ "$VERBOSE" = 1 ] || [ "$DRY" = 1 ]; then
  echo "hbrew-systemlink: linked=$now_linked skipped=$now_skipped fixed=$now_fixed reaped=$now_reaped"
fi

exit 0
